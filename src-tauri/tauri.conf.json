{
  "productName": "Wiring Diagram Builder",
  "version": "0.1.0",
  "identifier": "com.wiringdiagram.builder",
  "build": {
    "devPath": "http://localhost:5173",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "app": {
    "windows": [
      {
        "title": "Wiring Diagram Builder",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "identifier": "com.wiringdiagram.builder",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
